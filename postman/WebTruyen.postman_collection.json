    {
      "name": "Truyen",
      "item": [
        {
          "name": "Create Truyen",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Has required fields', function () {",
                  "  pm.expect(json).to.have.property('id');",
                  "  pm.expect(json).to.have.property('title');",
                  "  pm.expect(json).to.have.property('slug');",
                  "  pm.expect(json).to.have.property('publishStatus');",
                  "});",
                  "",
                  "pm.test('Echoes request fields', function () {",
                  "  const req = pm.request.body && pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};",
                  "  if (req.title) pm.expect(json.title).to.eql(req.title);",
                  "  if (req.slug) pm.expect(json.slug).to.eql(req.slug);",
                  "  if (req.description) pm.expect(json.description).to.eql(req.description);",
                  "  if (req.coverImage) pm.expect(json.coverImage).to.eql(req.coverImage);",
                  "});",
                  "",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('truyenId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
