{
  "info": {
    "_postman_id": "5c2a57ae-8b12-4c21-bdf5-9c585d7dc49f",
    "name": "WebTruyen - Mail & OTP",
    "description": "Postman collection to test SMTP mail sending and OTP reset password flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.accessToken) {",
                  "  pm.environment.set('token', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Register (For OTP Email)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 or 400 (already exists)', function () {",
                  "  pm.expect([200, 400]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{otpUsername}}\",\n  \"email\": \"{{otpEmail}}\",\n  \"password\": \"{{otpCurrentPassword}}\",\n  \"avatar\": \"\",\n  \"bio\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin Mail",
      "item": [
        {
          "name": "Send Test Email (ROLE_ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"{{testEmailTo}}\",\n  \"subject\": \"{{testEmailSubject}}\",\n  \"html\": \"<b>WebTruyen SMTP test</b>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/mail/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "mail",
                "test"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Password Reset (OTP)",
      "item": [
        {
          "name": "Send OTP (Reset Password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otpEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/password/reset/otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password",
                "reset",
                "otp"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Confirm Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otpEmail}}\",\n  \"otp\": \"{{otpCode}}\",\n  \"newPassword\": \"{{otpNewPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/password/reset/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "password",
                "reset",
                "confirm"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}

